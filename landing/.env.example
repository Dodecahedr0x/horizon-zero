# Public origin of the horizon-zero web service, which serves /assets and the game.
# Vite inlines this at build time. On Render, set VITE_WEB_ORIGIN in the static site env
# to that public URL, for example https://horizon-zero.onrender.com
# Local `vite` dev uses http://127.0.0.1:4715 when this is unset.
# VITE_WEB_ORIGIN=https://horizon-zero.onrender.com
