# Copy to .env at the repo root for local runs. Render uses dashboard env vars and does not need this file.

# Client flag. true runs the game against the local ledger and does not load a browser wallet. false keeps the Solana wallet path.
VITE_DEV_MODE=false

# Game server Solana JSON-RPC endpoint. The server (app/server.js, or Vite in dev) reads the chain and builds the
# transactions the wallet signs; the page never sees this. Unset is the local stack (pnpm localnet), http://127.0.0.1:8899.
# Set it for a deployment: https://api.devnet.solana.com or a mainnet RPC.
RPC_URL=

# Game server MagicBlock ephemeral rollup JSON-RPC endpoint. Unset is the local rollup, http://127.0.0.1:7799. A
# deployment sets it to the rollup that serves the validator the program was built for (HZ_VALIDATOR).
ER_RPC_URL=

# Game server MagicBlock VRF oracle queue, an ephemeral queue whose oracle calls back into the rollup. Unset is the local
# test queue Sc9MJUngNbQXSXGP3F67KvKwVnhaYn6kcioxXNVowYT. A deployment uses MagicBlock's DEFAULT_EPHEMERAL_QUEUE
# 5hBR571xnXppuCPveTrctfTU7tJLSN94nq7kv7FRK5Tc. It must be the queue the program was built for (HZ_VRF_QUEUE), or
# lock_army fails with BadQueue.
ORACLE_QUEUE=

# Landing client game web origin inlined by Vite. Unset local dev uses http://127.0.0.1:4715.
VITE_WEB_ORIGIN=

# App server base URL for the indexer. The /api proxy and the /chain backend both read it.
INDEXER_URL=http://127.0.0.1:4714

# Indexer listen port. The indexer start scripts pass this to that process only. Render injects PORT on the indexer service; this variable is the local one.
INDEXER_PORT=4714

# Comma-separated browser origins allowed to read GET /assets. Unset local allows landing dev http://127.0.0.1:4711 and preview http://127.0.0.1:4716.
ASSET_CORS_ORIGINS=

# Indexer SQLite file. Relative paths are resolved from the repo root. Gitignored.
DATABASE_PATH=indexer/data/horizon.db

# Local no-wallet ledger SQLite file used when VITE_DEV_MODE=true. Relative paths resolve from the repo root. Gitignored. Not the indexer database. A value already set in the process is kept.
LOCAL_LEDGER_PATH=data/local-ledger.db

# Local ledger listen port. Vite proxies /api/local here. Default 4713 stays off Vite 4710, the indexer 4714, and the asset studio 4712. A value already set in the process is kept.
LOCAL_LEDGER_PORT=4713

# Indexer JSON-RPC endpoint: the MagicBlock ephemeral rollup, not the base layer (Armies, Behaviors and Battles exist only
# there). Its WebSocket is the next port. The local rollup is http://127.0.0.1:7799, the indexer's default when unset.
# pnpm localnet starts its own indexer with this set to the local rollup and its database under target/localnet.
SOLANA_RPC_URL=http://127.0.0.1:7799

# Indexer Horizon Zero program id.
PROGRAM_ID=zeroDcScmnx7TSvWvnKBa81Gcq34T1QSRWH182YdqRg

# Initial asset studio image provider when tools/asset-studio/provider.json is absent. The page picker overrides this for the next generate request. codex or agent.
ASSET_IMAGE_PROVIDER=codex

# Codex CLI used when the image provider is codex. Empty in the process means `codex` on PATH.
ASSET_CODEX_BIN=codex

# Executable used when the image provider is agent.
ASSET_AGENT_BIN=agent

# Optional Codex home. Empty lets the Codex CLI use ~/.codex.
CODEX_HOME=

# Asset studio Meshy secret. Server-side only; do not prefix with VITE_.
MESHY_API_KEY=

# Trailer generator (tools/trailer/generate.mjs) ModelArk API key. The account must have the script's Seedance model activated. Server-side only; do not prefix with VITE_.
ARK_API_KEY=

# Optional ModelArk base URL. Unset is https://ark.ap-southeast.bytepluses.com/api/v3. Volcengine (China) is https://ark.cn-beijing.volces.com/api/v3.
ARK_BASE_URL=

# Optional Seedance model id or endpoint id. Unset uses the `model` line in tools/trailer/script.md.
ARK_VIDEO_MODEL=

# Optional listen port. Defaults: app 4715, asset studio 4712. Leave unset so those stay distinct; a set value applies to every process. The indexer uses INDEXER_PORT locally. Render injects PORT on the indexer service.
# PORT=4715
